<idea-plugin>
    <id>com.hunkontech.privacyguardrail</id>
    <name>Redacto</name>
    <vendor url="https://github.com/HunKonTech/Redacto">HunKonTech</vendor>
    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Redacto"
                    anchor="right"
                    icon="/icons/redacto.svg"
                    factoryClass="com.hunkontech.privacyguardrail.PanelToolWindowFactory"/>
        <notificationGroup id="Redacto" displayType="BALLOON"/>
    </extensions>

    <actions>
        <action id="PrivacyGuardrail.AnonymizeSelection"
                class="com.hunkontech.privacyguardrail.AnonymizeSelectionAction"
                text="Anonymize with Redacto"
                description="Show the selection anonymized in the Redacto tool window (the selection is not changed)"
                icon="/icons/redacto.svg">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ConsoleEditorPopupMenu" anchor="last"/>
        </action>
        <action id="PrivacyGuardrail.AnonymizeClipboard"
                class="com.hunkontech.privacyguardrail.AnonymizeClipboardAction"
                text="Anonymize Clipboard with Redacto"
                description="Show the clipboard text (e.g. copied from the terminal) anonymized in the Redacto tool window"
                icon="/icons/redacto.svg">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>

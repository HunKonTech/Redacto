# Keys for the fallback translators of scripts/i18n/machine-translate.js.
# Copy this file to scripts/i18n/.env (git-ignored) and fill in what you have;
# an empty or missing key just leaves that service out. Variables already set
# in the environment take precedence over this file.
#
# Order: Google (no key) -> Microsoft -> DeepL -> Argos (offline, if installed)

# Azure AI Translator, free F0 tier: 2M characters/month.
# Azure portal -> Translator resource -> Keys and Endpoint -> KEY 1.
MICROSOFT_TRANSLATOR_KEY=
# The resource's "Location/Region", e.g. westeurope. Leave empty for a Global resource.
MICROSOFT_TRANSLATOR_REGION=

# DeepL API Free: 500k characters/month (free keys end in ":fx").
# https://www.deepl.com/your-account/keys
DEEPL_API_KEY=
